<?php
$question ??= null;
$choices ??= [];
?>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Question</title>
</head>

<body>
    <?php if (!empty($error)): ?>
        <p style="color: red">
            <?= htmlspecialchars(
                $error,
                ENT_QUOTES,
                'UTF-8'
            ) ?>
        </p>
    <?php endif; ?>

    <?php if ($question === null): ?>
        <h1>Question not found</h1>
    <?php else: ?>
        <h1>Question</h1>

        <p>
            <?= htmlspecialchars(
                $question['question_text'],
                ENT_QUOTES,
                'UTF-8'
            ) ?>
        </p>

        <h2>Choices</h2>

        <?php if ($choices === []): ?>
            <p>No choices found.</p>
        <?php else: ?>
            <ul>
                <?php foreach ($choices as $choice): ?>
                    <li>
                        <?= htmlspecialchars(
                            $choice['choice_text'],
                            ENT_QUOTES,
                            'UTF-8'
                        ) ?>

                        <?php if ((bool) $choice['is_correct']): ?>
                            => Correct ✅
                        <?php endif; ?>
                    </li>
                <?php endforeach; ?>
            </ul>
        <?php endif; ?>
        <p>Course ID: <?= (int) $question['course_id'] ?></p>
    <?php endif; ?>

    <a href="/newSummerTraining/3Project/backend/api/questions">
        Back to questions
    </a>
</body>

</html>