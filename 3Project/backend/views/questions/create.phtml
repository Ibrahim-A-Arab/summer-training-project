<?php

$error ??= null;
$oldQuestion ??= '';
$courseId ??= 0;
$questionType ??= 'MCQ';
$correctAnswer ??= null;

$oldChoices ??= [
    [
        'text' => '',
        'correct' => false
    ],
    [
        'text' => '',
        'correct' => false
    ]
];

$oldChoices = array_values($oldChoices);

?>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Create question</title>
</head>

<body>
    <h1>Create question</h1>

    <?php if ($error !== null): ?>
        <p style="color: red">
            <?= htmlspecialchars($error, ENT_QUOTES, 'UTF-8') ?>
        </p>
    <?php endif; ?>

    <form
        method="POST"
        action="/newSummerTraining/3Project/backend/api/courses/<?= (int) $courseId ?>/questions">

        <label for="question">Question</label>

        <input
            id="question"
            name="question"
            type="text"
            value="<?= htmlspecialchars(
                        $oldQuestion,
                        ENT_QUOTES,
                        'UTF-8'
                    ) ?>"
            required>

        <label for="question_type">Question type</label>

        <select
            id="question_type"
            name="question_type"
            required>

            <option
                value="MCQ"
                <?= $questionType === 'MCQ'
                    ? 'selected'
                    : '' ?>>
                Multiple choice
            </option>

            <option
                value="TrueOrFalse"
                <?= $questionType === 'TrueOrFalse'
                    ? 'selected'
                    : '' ?>>
                True / False
            </option>
        </select>

        <div id="multiple-choice-editor">
            <fieldset>
                <legend>Choices</legend>

                <div id="choices">
                    <?php foreach ($oldChoices as $index => $choice): ?>
                        <div class="choice-row">
                            <input
                                name="choices[<?= $index ?>][text]"
                                type="text"
                                placeholder="Choice <?= $index + 1 ?>"
                                value="<?= htmlspecialchars(
                                            (string) ($choice['text'] ?? ''),
                                            ENT_QUOTES,
                                            'UTF-8'
                                        ) ?>"
                                required>

                            <label>
                                <input
                                    name="choices[<?= $index ?>][correct]"
                                    type="checkbox"
                                    value="1"
                                    <?= !empty($choice['correct'])
                                        ? 'checked'
                                        : '' ?>>
                                Correct
                            </label>

                            <button
                                type="button"
                                class="remove-choice">
                                −
                            </button>
                        </div>
                    <?php endforeach; ?>
                </div>

                <button type="button" id="add-choice">
                    + Add choice
                </button>
            </fieldset>
        </div>

        <div id="true-false-editor" hidden>
            <fieldset>
                <legend>Correct answer</legend>

                <label>
                    <input
                        type="radio"
                        name="correct_answer"
                        value="true"
                        <?= $correctAnswer === 'true'
                            ? 'checked'
                            : '' ?>>
                    True
                </label>

                <label>
                    <input
                        type="radio"
                        name="correct_answer"
                        value="false"
                        <?= $correctAnswer === 'false'
                            ? 'checked'
                            : '' ?>>
                    False
                </label>
            </fieldset>
        </div>

        <button type="submit">Create</button>
    </form>

    <script>
        const questionType =
            document.getElementById('question_type');

        const multipleChoiceEditor =
            document.getElementById('multiple-choice-editor');

        const trueFalseEditor =
            document.getElementById('true-false-editor');

        const choicesContainer =
            document.getElementById('choices');

        const addChoiceButton =
            document.getElementById('add-choice');

        let nextChoiceIndex = <?= count($oldChoices) ?>;

        function updateQuestionEditor() {
            const isTrueFalse =
                questionType.value === 'TrueOrFalse';

            multipleChoiceEditor.hidden = isTrueFalse;
            trueFalseEditor.hidden = !isTrueFalse;

            multipleChoiceEditor
                .querySelectorAll('input, button')
                .forEach(function(element) {
                    element.disabled = isTrueFalse;
                });

            trueFalseEditor
                .querySelectorAll('input')
                .forEach(function(input) {
                    input.disabled = !isTrueFalse;
                    input.required = isTrueFalse;
                });
        }

        questionType.addEventListener(
            'change',
            updateQuestionEditor
        );

        addChoiceButton.addEventListener(
            'click',
            function() {
                const index = nextChoiceIndex++;

                const row = document.createElement('div');
                row.className = 'choice-row';

                row.innerHTML = `
                    <input
                        name="choices[${index}][text]"
                        type="text"
                        placeholder="Choice"
                        required
                    >

                    <label>
                        <input
                            name="choices[${index}][correct]"
                            type="checkbox"
                            value="1"
                        >
                        Correct
                    </label>

                    <button
                        type="button"
                        class="remove-choice">
                        −
                    </button>
                `;

                choicesContainer.appendChild(row);
                updateChoiceLabels();
            }
        );

        choicesContainer.addEventListener(
            'click',
            function(event) {
                if (
                    !event.target.classList.contains(
                        'remove-choice'
                    )
                ) {
                    return;
                }

                const choiceRows =
                    choicesContainer.querySelectorAll(
                        '.choice-row'
                    );

                if (choiceRows.length <= 2) {
                    alert(
                        'A question must have at least two choices.'
                    );

                    return;
                }

                event.target
                    .closest('.choice-row')
                    .remove();

                updateChoiceLabels();
            }
        );

        function updateChoiceLabels() {
            const rows =
                choicesContainer.querySelectorAll(
                    '.choice-row'
                );

            rows.forEach(function(row, index) {
                const input = row.querySelector(
                    'input[type="text"]'
                );

                input.placeholder =
                    `Choice ${index + 1}`;
            });
        }

        updateQuestionEditor();
    </script>
</body>

</html>