<?php

/** @var array<string, mixed>|null $question */
$question ??= null;
$choices ??= [];
?>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Edit question</title>
</head>

<body>
    <?php if ($question === null): ?>
        <h1>Question not found</h1>
    <?php else: ?>
        <h1>Edit question</h1>

        <?php if (!empty($error)): ?>
            <p style="color: red">
                <?= htmlspecialchars($error, ENT_QUOTES, 'UTF-8') ?>
            </p>
        <?php endif; ?>

        <form
            method="POST"
            action="/newSummerTraining/3Project/backend/api/questions/<?= (int) $question['id'] ?>/update">
            <label for="question">Question</label>
            <input
                id="question"
                name="question"
                type="text"
                value="<?= htmlspecialchars(
                            $question['question_text'],
                            ENT_QUOTES,
                            'UTF-8'
                        ) ?>"
                required>

            <fieldset>
                <legend>Choices</legend>

                <div id="choices">
                    <?php foreach ($choices as $index => $choice): ?>
                        <?php
                        $choiceText =
                            $choice['text']
                            ?? $choice['choice_text']
                            ?? '';

                        $isCorrect =
                            isset($choice['correct'])
                            || !empty($choice['is_correct']);
                        ?>

                        <div class="choice-row">
                            <input
                                name="choices[<?= $index ?>][text]"
                                type="text"
                                placeholder="Choice <?= $index + 1 ?>"
                                value="<?= htmlspecialchars(
                                            (string) $choiceText,
                                            ENT_QUOTES,
                                            'UTF-8'
                                        ) ?>"
                                required>

                            <label>
                                <input
                                    name="choices[<?= $index ?>][correct]"
                                    type="checkbox"
                                    value="1"
                                    <?= $isCorrect ? 'checked' : '' ?>>
                                Correct
                            </label>

                            <button
                                type="button"
                                class="remove-choice">
                                −
                            </button>
                        </div>
                    <?php endforeach; ?>
                </div>

                <button type="button" id="add-choice">
                    + Add choice
                </button>
            </fieldset>


            <button type="submit">Update</button>
        </form>
    <?php endif; ?>

    <?php if ($question !== null): ?>
    <script>
        const choicesContainer = document.getElementById('choices');
        const addChoiceButton = document.getElementById('add-choice');

        let nextChoiceIndex = <?= count($choices) ?>;

        addChoiceButton.addEventListener('click', function() {
            const index = nextChoiceIndex++;

            const row = document.createElement('div');
            row.className = 'choice-row';

            row.innerHTML = `
            <input
                name="choices[${index}][text]"
                type="text"
                placeholder="Choice"
                required
            >

            <label>
                <input
                    name="choices[${index}][correct]"
                    type="checkbox"
                    value="1"
                >
                Correct
            </label>

            <button type="button" class="remove-choice">
                −
            </button>
        `;

            choicesContainer.appendChild(row);
            updateChoiceLabels();
        });

        choicesContainer.addEventListener('click', function(event) {
            if (!event.target.classList.contains('remove-choice')) {
                return;
            }

            const choiceRows =
                choicesContainer.querySelectorAll('.choice-row');

            if (choiceRows.length <= 2) {
                alert('A question must have at least two choices.');
                return;
            }

            event.target.closest('.choice-row').remove();

            updateChoiceLabels();
        });

        function updateChoiceLabels() {
            const rows =
                choicesContainer.querySelectorAll('.choice-row');

            rows.forEach(function(row, index) {
                const input = row.querySelector(
                    'input[type="text"]'
                );

                input.placeholder = `Choice ${index + 1}`;
            });
        }
    </script>
    <?php endif; ?>
</body>

</html>