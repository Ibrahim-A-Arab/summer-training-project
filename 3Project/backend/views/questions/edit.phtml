<?php
/** @var array<string, mixed>|null $question */
$question ??= null;
?>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit question</title>
</head>
<body>
    <?php if ($question === null): ?>
        <h1>Question not found</h1>
    <?php else: ?>
        <h1>Edit question</h1>

        <?php if (!empty($error)): ?>
            <p style="color: red">
                <?= htmlspecialchars($error, ENT_QUOTES, 'UTF-8') ?>
            </p>
        <?php endif; ?>

        <form
            method="POST"
            action="/newSummerTraining/3Project/backend/api/questions/<?= (int) $question['id'] ?>/update"
        >
            <label for="question">Question</label>
            <input
                id="question"
                name="question"
                type="text"
                value="<?= htmlspecialchars(
                    $question['question_text'],
                    ENT_QUOTES,
                    'UTF-8'
                ) ?>"
                required
            >


            <button type="submit">Update</button>
        </form>
    <?php endif; ?>
</body>
</html>
