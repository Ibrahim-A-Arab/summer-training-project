<?php

$error ??= null;
$choices ??= [];
$questionType ??= $question['question_type'] ?? 'MCQ';
$correctAnswer ??= null;

$pageTitle = 'Edit Question';
$activePage = 'courses';

if (isset($question) && is_array($question)) {
    $courseId = (int) $question['course_id'];

    // Find the currently correct True/False answer.
    if (
        $questionType === 'TrueOrFalse'
        && $correctAnswer === null
    ) {
        foreach ($choices as $choice) {
            $choiceText = strtolower(
                (string) (
                    $choice['text']
                    ?? $choice['choice_text']
                    ?? ''
                )
            );

            $isCorrect =
                !empty($choice['correct'])
                || !empty($choice['is_correct']);

            if ($isCorrect && in_array(
                $choiceText,
                ['true', 'false'],
                true
            )) {
                $correctAnswer = $choiceText;
                break;
            }
        }
    }
}

