
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Questions</title>
</head>

<body>
    
    <h1>Questions</h1>

    <a href="/newSummerTraining/3Project/backend/api/courses/create">
        Add course
    </a>

    <?php if (isset($courseId)): ?>
    <a href="/newSummerTraining/3Project/backend/api/courses/<?= (int) $courseId ?>/questions/create">
        Add question to this course
    </a>
    <?php endif; ?>

    <?php if (empty($questions)): ?>
        <p>No questions found.</p>
    <?php else: ?>
        <ul>
            <?php foreach ($questions as $question): ?>
                <li>
                    <a href="/newSummerTraining/3Project/backend/api/questions/<?= (int) $question['id'] ?>">
                        <?= htmlspecialchars(
                            $question['question_text'],
                            ENT_QUOTES,
                            'UTF-8'
                        ) ?>
                    </a>

                    <a href="/newSummerTraining/3Project/backend/api/questions/<?= (int) $question['id'] ?>/edit">
                        Edit
                    </a>

                    <form
                        method="POST"
                        action="/newSummerTraining/3Project/backend/api/questions/<?= (int) $question['id'] ?>/delete"
                        style="display: inline"
                    >
                        <button type="submit">Delete</button>
                    </form>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php endif; ?>
</body>

</html>
