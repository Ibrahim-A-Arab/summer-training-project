<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Questions</title>
</head>

<body>
    <h1>Questions</h1>

    <?php if (empty($questions)): ?>
        <p>No questions found.</p>
    <?php else: ?>
        <ul>
            <?php foreach ($questions as $question): ?>
                <li>
                    <a href="/newSummerTraining/3Project/backend/api/questions/<?= (int) $question['question_id'] ?>">
                        <?= htmlspecialchars($question['question_text'], ENT_QUOTES, 'UTF-8') ?>
                    </a>
                    (course <?= (int) $question['course_id'] ?>,
                    weight <?= htmlspecialchars((string) $question['weight'], ENT_QUOTES, 'UTF-8') ?>)
                    <a href="/newSummerTraining/3Project/backend/api/questions/<?= (int) $question['question_id'] ?>/edit">Edit</a>
                    <a href="/newSummerTraining/3Project/backend/api/courses/<?= (int) $question['course_id'] ?>/questions/create">Add to this course</a>
                    <form method="POST"
                          action="/newSummerTraining/3Project/backend/api/questions/<?= (int) $question['question_id'] ?>/delete"
                          style="display: inline">
                        <button type="submit">Delete</button>
                    </form>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php endif; ?>

</body>

</html>
