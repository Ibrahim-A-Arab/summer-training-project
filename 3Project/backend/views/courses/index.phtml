<?php $courses ??= []; ?>

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Courses</title>
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet">
</head>

<body>
    <h1>Courses</h1>

    <a href="/newSummerTraining/3Project/backend/api/courses/create">
        Add course
    </a>

    <?php if ($courses === []): ?>
        <p>No courses found.</p>
    <?php else: ?>
        <ul>
            <?php foreach ($courses as $course): ?>
                <li>
                    <a href="/newSummerTraining/3Project/backend/api/courses/<?= (int) $course['id'] ?>/questions">
                        <?= htmlspecialchars(
                            $course['course_code'],
                            ENT_QUOTES,
                            'UTF-8'
                        ) ?>

                        —

                        <?= htmlspecialchars(
                            $course['course_name'],
                            ENT_QUOTES,
                            'UTF-8'
                        ) ?>
                    </a>
                </li>
            <?php endforeach; ?>
        </ul>
    <?php endif; ?>
</body>

</html>